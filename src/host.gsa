// Crema Host FFI Bindings (`crema.host`):
// Connects `crema.app.Runtime` to WebAssembly (`host/web/crema.js`) or Native (`host/native/crema_macos.m`) hosts.

use crema.app.{HostBridge, MkHostBridge}

pub extern "crema_host_present" def cremaHostPresent(
    words: MutArray Int64,
    wordCount: Int,
    strs: MutArray String,
    strCount: Int
): Void

pub extern "crema_host_set_cursor" def cremaHostSetCursor(cursor: String): Void
pub extern "crema_host_focus_ime" def cremaHostFocusIme(inputId: String, value: String, x: Float, y: Float, w: Float, h: Float): Void
pub extern "crema_host_blur_ime" def cremaHostBlurIme(): Void
pub extern "crema_host_play_sfx" def cremaHostPlaySfx(sfxId: String): Void
pub extern "crema_host_save_local" def cremaHostSaveLocal(key: String, val: String): Void
pub extern "crema_host_send_net" def cremaHostSendNet(payload: String): Void
pub extern "crema_host_connect_net" def cremaHostConnectNet(urlOrMode: String, user: String, token: String): Void

pub def envHost(): HostBridge = MkHostBridge {
    hbPresent: (w, wc, s, sc) -> cremaHostPresent(w, wc, s, sc),
    hbSetCursor: (c) -> cremaHostSetCursor(c),
    hbFocusIme: (id, v, x, y, w, h) -> cremaHostFocusIme(id, v, x, y, w, h),
    hbBlurIme: () -> cremaHostBlurIme(),
    hbPlaySfx: (s) -> cremaHostPlaySfx(s),
    hbSaveLocal: (k, v) -> cremaHostSaveLocal(k, v),
    hbSendNet: (p) -> cremaHostSendNet(p),
    hbConnectNet: (m, u, t) -> cremaHostConnectNet(m, u, t),
}
