pub def padTRBL(t: Float, r: Float, b: Float, l: Float): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: maxFloat(0.0, t), bsPadR: maxFloat(0.0, r), bsPadB: maxFloat(0.0, b), bsPadL: maxFloat(0.0, l), bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def padXY(px: Float, py: Float): StyleMod = padTRBL(py, px, py, px)
pub def pad(p: Float): StyleMod = padTRBL(p, p, p, p)

