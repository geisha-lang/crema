pub def centerContent(): StyleMod = (s) -> alignY(AlignMid)(alignX(AlignMid)(s))

pub def bgGrad(topCol: Color, botCol: Color): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: topCol, bsFillBot: botCol,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def bg(col: Color): StyleMod = bgGrad(col, col)

pub def border(width: Float, col: Color): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: col, bsBorderW: maxFloat(0.0, width), bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

