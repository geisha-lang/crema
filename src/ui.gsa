    bsWidth: s.bsWidth, bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
