// Crema Layer 1 (`crema.ui`):
// Clay-inspired declarative Flexbox / ZStack / ScrollView layout engine,
// `Functor Element` component composition, CJK paragraph wrapping, and automatic hitbox/IME collection.

use std.option.{Option, Some, None}
use std.list.{listLen, listRev, listAppend, listMap}
use std.vec.{Vec, vecNew, vecPush, vecToList}
use std.map.{StrMap, strMapGet}
use std.control.{Functor, fmap}
use crema.gfx.{
    Vec2, vec2, Rect, MkRect, rect, rectContains, rectIntersect,
    Color, rgba, rgb, hexColor, withAlpha,
    FontFamily, FontSans, FontSerif,
    TextAlign, AlignLeft, AlignCenter, AlignRight,
    FontSpec, fontSans, fontSerif, fontMono,
    measureTextWidth, truncateWithEllipsis, wrapTextLines,
    DrawList, drawCard, drawRect, drawFillRect, drawProgressBar,
    drawText, drawImage, pushClip, popClip, emitImeInput
}
use crema.gfx.{minFloat, maxFloat, clampFloat, clamp01}

// ============================================================================
// 1. Sizing, Alignment, Theme & Composable `StyleMod` Modifiers
// ============================================================================

pub data AxisSize {
    SizeFit,
    SizeFixed(Float),
    SizeGrow(Float),
    SizePercent(Float),
}

pub data AlignItems {
    AlignStart,
    AlignMid,
    AlignEnd,
    AlignStretch,
}

pub data BoxStyle {
    MkBoxStyle {
        bsWidth: AxisSize,
        bsHeight: AxisSize,
        bsMinW: Float,
        bsMinH: Float,
        bsMaxW: Float,
        bsMaxH: Float,
        bsPadT: Float,
        bsPadR: Float,
        bsPadB: Float,
        bsPadL: Float,
        bsGap: Float,
        bsAlignX: AlignItems,
        bsAlignY: AlignItems,
        bsFillTop: Color,
        bsFillBot: Color,
        bsBorderCol: Color,
        bsBorderW: Float,
        bsRadius: Float,
        bsShadowCol: Color,
        bsShadowY: Float,
        bsShadowBlur: Float,
        bsClip: Bool,
    },
}

pub type StyleMod = BoxStyle -> BoxStyle

pub def defaultBoxStyle(): BoxStyle = MkBoxStyle {
    bsWidth: SizeFit,
    bsHeight: SizeFit,
    bsMinW: 0.0,
    bsMinH: 0.0,
    bsMaxW: 999999.0,
    bsMaxH: 999999.0,
    bsPadT: 0.0,
    bsPadR: 0.0,
    bsPadB: 0.0,
    bsPadL: 0.0,
    bsGap: 0.0,
    bsAlignX: AlignStart,
    bsAlignY: AlignStart,
    bsFillTop: 0,
    bsFillBot: 0,
    bsBorderCol: 0,
    bsBorderW: 0.0,
    bsRadius: 0.0,
    bsShadowCol: 0,
    bsShadowY: 0.0,
    bsShadowBlur: 0.0,
    bsClip: false,
}

pub def applyStyles(mods: List StyleMod): BoxStyle = {
    let cur = cellNew(mods);
    let st = cellNew(defaultBoxStyle());
    while (match cellGet(cur) { Nil -> false, _ -> true }) {
        match cellGet(cur) {
            Cons(fn, rest) -> {
                cellSet(st, fn(cellGet(st)));
                cellSet(cur, rest)
            },
            Nil -> (),
        }
    };
    cellGet(st)
}

pub def wFit(): StyleMod = (s) -> MkBoxStyle {
    bsWidth: SizeFit, bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def hFit(): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: SizeFit, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def wFixed(px: Float): StyleMod = (s) -> MkBoxStyle {
    bsWidth: SizeFixed(maxFloat(0.0, px)), bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def hFixed(px: Float): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: SizeFixed(maxFloat(0.0, px)), bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def fixedSize(w: Float, h: Float): StyleMod = (s) -> hFixed(h)(wFixed(w)(s))

pub def wGrow(weight: Float): StyleMod = (s) -> MkBoxStyle {
    bsWidth: SizeGrow(maxFloat(0.001, weight)), bsHeight: s.bsHeight, bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
    bsAlignX: s.bsAlignX, bsAlignY: s.bsAlignY, bsFillTop: s.bsFillTop, bsFillBot: s.bsFillBot,
    bsBorderCol: s.bsBorderCol, bsBorderW: s.bsBorderW, bsRadius: s.bsRadius,
    bsShadowCol: s.bsShadowCol, bsShadowY: s.bsShadowY, bsShadowBlur: s.bsShadowBlur,
    bsClip: s.bsClip,
}

pub def hGrow(weight: Float): StyleMod = (s) -> MkBoxStyle {
    bsWidth: s.bsWidth, bsHeight: SizeGrow(maxFloat(0.001, weight)), bsMinW: s.bsMinW, bsMinH: s.bsMinH, bsMaxW: s.bsMaxW, bsMaxH: s.bsMaxH,
    bsPadT: s.bsPadT, bsPadR: s.bsPadR, bsPadB: s.bsPadB, bsPadL: s.bsPadL, bsGap: s.bsGap,
